+// swift-tools-version: 5.9
+import PackageDescription
+
+// Added by the Ledger project (see patches/) so Capacitor's SPM integration
+// links this plugin into the iOS app. The upstream package only ships a
+// CocoaPods podspec.
+let package = Package(
+    name: "CapacitorCommunitySpeechRecognition",
+    platforms: [.iOS(.v14)],
+    products: [
+        .library(
+            name: "CapacitorCommunitySpeechRecognition",
+            targets: ["SpeechRecognitionPlugin"])
+    ],
+    dependencies: [
+        .package(url: "https://github.com/ionic-team/capacitor-swift-pm.git", from: "8.0.0")
+    ],
+    targets: [
+        .target(
+            name: "SpeechRecognitionPlugin",
+            dependencies: [
+                .product(name: "Capacitor", package: "capacitor-swift-pm")
+            ],
+            path: "ios/Plugin",
+            sources: ["Plugin.swift"])
+    ]
+)
