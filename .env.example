# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real API keys.
# ---------------------------------------------------------------------------

# Twilio — used for /api/send-sms. Twilio's auth model requires the Account
# SID + Auth Token pair (not a single API key), plus the "from" number you
# purchased/verified in the Twilio console.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
SMS_SENDER_NUMBER=+15555550123

# Optional — if set, this base URL is appended to outgoing SMS messages as
# a "view & pay" link (e.g. https://your-app.com/invoice/INV-1001).
NEXT_PUBLIC_INVOICE_BASE_URL=
